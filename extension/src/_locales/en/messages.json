  "welcomeTitle": {
    "message": "Welcome to Orbit"
  },
  "welcomeIntro": {
    "message": "A fast browser that keeps what you do on your device. No accounts, no ads and no tracking, by design."
  },
  "welcomeProtectTitle": {
    "message": "Protection is already on"
  },
  "welcomeProtectText": {
    "message": "Orbit's Shields work on this device, before pages load what they ask for. The shield beside the address bar shows what was blocked on a page, and turns Shields off for a site that misbehaves."
  },
  "welcomeFactAds": {
    "message": "Ads and pop-ups"
  },
  "welcomeFactTrackers": {
    "message": "Trackers that follow you from site to site"

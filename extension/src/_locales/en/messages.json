  "privacyIntro": {
    "message": "Protections Orbit adds on top of the browser's own settings."
  },
  "fpTitle": {
    "message": "Fingerprinting protection"
  },
  "fpDetail": {
    "message": "Sites can tell browsers apart by reading technical details. This makes those details less useful for tracking you. No setting can make you impossible to track, and canvases in web workers are not covered."
  },
  "fpStandard": {
    "message": "Standard"
  },
  "fpStandardDetail": {
    "message": "Canvas, audio and graphics readings differ from site to site. Hardware details are rounded. This is the least likely to affect how sites work."
  },
  "fpStrict": {
    "message": "Strict"
  },
  "fpStrictDetail": {
    "message": "Also rounds screen size and changes text measurements slightly. Some sites may look or behave differently."
  },
  "fpOff": {
    "message": "Off"
  },
  "fpOffDetail": {
    "message": "Sites read your real values."
  },

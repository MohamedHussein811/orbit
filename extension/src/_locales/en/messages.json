    "message": "Bring your things to Orbit"
  },
  "welcomeBringText": {
    "message": "Copy your bookmarks and history from Chrome, Edge, Brave, Opera, Vivaldi or Firefox. Close that browser first so its history can be read. Everything stays on this device."
  },
  "welcomeImport": {
    "message": "Choose a browser to import from"
  },
  "welcomePasswordsTitle": {
    "message": "Passwords"
  },
  "welcomePasswordsText": {
    "message": "Other browsers lock saved passwords so only they can read them. To move them:"
  },
  "welcomePasswordsStep1": {
    "message": "In your old browser, open its password settings and choose Export passwords. It saves a CSV file."
  },
  "welcomePasswordsStep2": {
    "message": "In Orbit, open Passwords, choose Import passwords and pick that file."
  },
  "welcomePasswordsStep3": {
    "message": "Delete the CSV file afterwards. It holds your passwords as plain text."
  },
  "welcomeOpenPasswords": {

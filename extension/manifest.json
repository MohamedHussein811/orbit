{
  "manifest_version": 3,
  "name": "Orbit",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "update_url": "https://github.com/MohamedHussein811/orbit/releases/latest/download/orbit-extension-updates.xml",
  "version": "0.0.0",
  "key": "",
  "incognito": "spanning",
  "permissions": [
    "activeTab",
    "alarms",
    "bookmarks",
    "browsingData",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "favicon",
    "history",
    "privacy",
    "scripting",
    "search",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "action": {
    "default_title": "Shields",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/orbit-16.png", "32": "icons/orbit-32.png" }
  },
  "icons": { "16": "icons/orbit-16.png", "32": "icons/orbit-32.png", "48": "icons/orbit-48.png", "128": "icons/orbit-128.png" },
  "options_page": "privacy/privacy.html",
  "side_panel": { "default_path": "notes/notes.html" },
  "chrome_url_overrides": { "newtab": "newtab/newtab.html" },
  "web_accessible_resources": [
    { "resources": ["blocked/blocked.html"], "matches": ["<all_urls>"] }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "threats", "enabled": true, "path": "rules/threats.json" }
    ]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob: chrome-extension:; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://orbit.invalid https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}

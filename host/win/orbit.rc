#include <winres.h>

#define ORBIT_STR2(value) #value
#define ORBIT_STR(value) ORBIT_STR2(value)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 ICON "../../branding/icons/orbit.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ORBIT_V1, ORBIT_V2, ORBIT_V3, 0
 PRODUCTVERSION ORBIT_V1, ORBIT_V2, ORBIT_V3, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "NovaTech"
      VALUE "FileDescription", "Orbit"
      VALUE "FileVersion", ORBIT_STR(ORBIT_V1) "." ORBIT_STR(ORBIT_V2) "." ORBIT_STR(ORBIT_V3) ".0"
      VALUE "InternalName", "orbit"
      VALUE "LegalCopyright", "Copyright 2026 NovaTech"
      VALUE "OriginalFilename", "orbit.exe"
      VALUE "ProductName", "Orbit"
      VALUE "ProductVersion", ORBIT_STR(ORBIT_V1) "." ORBIT_STR(ORBIT_V2) "." ORBIT_STR(ORBIT_V3) ".0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

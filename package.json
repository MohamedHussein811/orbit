{
  "name": "orbit-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit, a privacy-focused desktop browser by NovaTech, built as a Chromium fork",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "filters:update": "node tools/filters.mjs update",
    "typecheck": "tsc --noEmit -p extension/tsconfig.json",
    "test:unit": "node --test tests/tools/*.test.mjs extension/test/*.test.ts"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}

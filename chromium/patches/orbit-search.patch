@@ -15,6 +15,8 @@
 #include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
 #include "chrome/browser/ui/navigator/browser_navigator.h"
 #include "chrome/common/extensions/api/search.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
 #include "components/search_engines/util.h"
 #include "content/public/browser/navigation_controller.h"
 #include "content/public/browser/web_contents.h"
@@ -196,4 +198,84 @@
   Respond(NoArguments());
 }
 
+namespace {
+
+// Orbit's built-in extension, the only caller allowed to read or change the
+// default search engine.
+constexpr char kOrbitExtensionId[] = "kceipbaiojomdibnboffoieecidpfdck";
+
+TemplateURLService* OrbitSearchEngines(content::BrowserContext* context) {
+  return context ? TemplateURLServiceFactory::GetForProfile(
+                       Profile::FromBrowserContext(context))
+                 : nullptr;
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction SearchGetDefaultFunction::Run() {
+  if (extension_id() != kOrbitExtensionId) {
+    return RespondNow(Error("Not available."));
+  }
+  TemplateURLService* service = OrbitSearchEngines(browser_context());
+  if (!service) {
+    return RespondNow(Error("No search engines."));
+  }
+  if (service->loaded()) {
+    return RespondNow(Result());
+  }
+  loaded_subscription_ = service->RegisterOnLoadedCallback(
+      base::BindOnce(&SearchGetDefaultFunction::OnLoaded, this));
+  service->Load();
+  return did_respond() ? AlreadyResponded() : RespondLater();
+}
+
+void SearchGetDefaultFunction::OnLoaded() {
+  Respond(Result());
+}
+
+ExtensionFunction::ResponseValue SearchGetDefaultFunction::Result() {
+  TemplateURLService* service = OrbitSearchEngines(browser_context());
+  const TemplateURL* engine =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  return ArgumentList(api::search::GetDefault::Results::Create(
+      engine ? base::UTF16ToUTF8(engine->keyword()) : std::string()));
+}
+
+ExtensionFunction::ResponseAction SearchSetDefaultFunction::Run() {
+  if (extension_id() != kOrbitExtensionId) {
+    return RespondNow(Error("Not available."));
+  }
+  std::optional<api::search::SetDefault::Params> params =
+      api::search::SetDefault::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  keyword_ = params->keyword;
+  TemplateURLService* service = OrbitSearchEngines(browser_context());
+  if (!service) {
+    return RespondNow(Error("No search engines."));
+  }
+  if (service->loaded()) {
+    return RespondNow(Result());
+  }
+  loaded_subscription_ = service->RegisterOnLoadedCallback(
+      base::BindOnce(&SearchSetDefaultFunction::OnLoaded, this));
+  service->Load();
+  return did_respond() ? AlreadyResponded() : RespondLater();
+}
+
+void SearchSetDefaultFunction::OnLoaded() {
+  Respond(Result());
+}
+
+ExtensionFunction::ResponseValue SearchSetDefaultFunction::Result() {
+  TemplateURLService* service = OrbitSearchEngines(browser_context());
+  TemplateURL* engine =
+      service ? service->GetTemplateURLForKeyword(base::UTF8ToUTF16(keyword_))
+              : nullptr;
+  if (!engine || !service->CanMakeDefault(engine)) {
+    return Error("This search engine can't be made the default.");
+  }
+  service->SetUserSelectedDefaultSearchProvider(engine);
+  return NoArguments();
+}
+
 }  // namespace extensions

+namespace {
+
+// Orbit's built-in extension, the only caller allowed to read or change the
+// default search engine.
+constexpr char kOrbitExtensionId[] = "kceipbaiojomdibnboffoieecidpfdck";
+
+TemplateURLService* OrbitSearchEngines(content::BrowserContext* context) {
+  return context ? TemplateURLServiceFactory::GetForProfile(
+                       Profile::FromBrowserContext(context))
+                 : nullptr;
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction SearchGetDefaultFunction::Run() {
+  if (extension_id() != kOrbitExtensionId) {
+    return RespondNow(Error("Not available."));
+  }
+  TemplateURLService* service = OrbitSearchEngines(browser_context());
+  if (!service) {
+    return RespondNow(Error("No search engines."));
+  }
+  if (service->loaded()) {
+    return RespondNow(Result());
+  }
+  loaded_subscription_ = service->RegisterOnLoadedCallback(
+      base::BindOnce(&SearchGetDefaultFunction::OnLoaded, this));
+  service->Load();
+  return did_respond() ? AlreadyResponded() : RespondLater();
+}
+
+void SearchGetDefaultFunction::OnLoaded() {
+  Respond(Result());
+}
+
+ExtensionFunction::ResponseValue SearchGetDefaultFunction::Result() {
+  TemplateURLService* service = OrbitSearchEngines(browser_context());
+  const TemplateURL* engine =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  return ArgumentList(api::search::GetDefault::Results::Create(
+      engine ? base::UTF16ToUTF8(engine->keyword()) : std::string()));
+}
+
+ExtensionFunction::ResponseAction SearchSetDefaultFunction::Run() {
+  if (extension_id() != kOrbitExtensionId) {
+    return RespondNow(Error("Not available."));
+  }
+  std::optional<api::search::SetDefault::Params> params =
+      api::search::SetDefault::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  keyword_ = params->keyword;
+  TemplateURLService* service = OrbitSearchEngines(browser_context());
+  if (!service) {
+    return RespondNow(Error("No search engines."));
+  }
+  if (service->loaded()) {
+    return RespondNow(Result());
+  }
+  loaded_subscription_ = service->RegisterOnLoadedCallback(
+      base::BindOnce(&SearchSetDefaultFunction::OnLoaded, this));
+  service->Load();
+  return did_respond() ? AlreadyResponded() : RespondLater();
+}
+
+void SearchSetDefaultFunction::OnLoaded() {
+  Respond(Result());
+}
+
+ExtensionFunction::ResponseValue SearchSetDefaultFunction::Result() {
+  TemplateURLService* service = OrbitSearchEngines(browser_context());
+  TemplateURL* engine =
+      service ? service->GetTemplateURLForKeyword(base::UTF8ToUTF16(keyword_))
+              : nullptr;
+  if (!engine || !service->CanMakeDefault(engine)) {
+    return Error("This search engine can't be made the default.");
+  }
+  service->SetUserSelectedDefaultSearchProvider(engine);
+  return NoArguments();
+}
+
+ExtensionFunction::ResponseAction SearchGetStartupFunction::Run() {
+  if (extension_id() != kOrbitExtensionId) {
+    return RespondNow(Error("Not available."));
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  const SessionStartupPref pref = SessionStartupPref::GetStartupPref(profile);
+  api::search::StartupSettings settings;
+  switch (pref.type) {
+    case SessionStartupPref::LAST:
+    case SessionStartupPref::LAST_AND_URLS:
+      settings.mode = api::search::StartupMode::kRestore;
+      break;
+    case SessionStartupPref::URLS:
+      settings.mode = api::search::StartupMode::kPages;
+      break;
+    default:
+      settings.mode = api::search::StartupMode::kNewTab;
+      break;
+  }
+  for (const GURL& url : pref.urls) {
+    settings.urls.push_back(url.spec());
+  }
+  settings.managed =
+      SessionStartupPref::TypeIsManaged(profile->GetPrefs()) ||
+      SessionStartupPref::URLsAreManaged(profile->GetPrefs());
+  return RespondNow(
+      ArgumentList(api::search::GetStartup::Results::Create(settings)));
+}
+
+ExtensionFunction::ResponseAction SearchSetStartupFunction::Run() {
+  if (extension_id() != kOrbitExtensionId) {
+    return RespondNow(Error("Not available."));
+  }
+  std::optional<api::search::SetStartup::Params> params =
+      api::search::SetStartup::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  if (profile->IsGuestSession()) {
+    return RespondNow(Error("Not available in a guest window."));
+  }
+  SessionStartupPref::Type type = SessionStartupPref::DEFAULT;
+  switch (params->settings.mode) {
+    case api::search::StartupMode::kRestore:
+      type = SessionStartupPref::LAST;
+      break;
+    case api::search::StartupMode::kPages:
+      type = SessionStartupPref::URLS;
+      break;
+    default:
+      break;
+  }
+  SessionStartupPref pref(type);
+  for (const std::string& spec : params->settings.urls) {
+    GURL url(spec);
+    if (!url.is_valid() || !(url.SchemeIsHTTPOrHTTPS() ||
+                             url.SchemeIs(content::kChromeUIScheme))) {
+      return RespondNow(Error("Each page must be a web address."));
+    }
+    pref.urls.push_back(std::move(url));
+  }
+  SessionStartupPref::SetStartupPref(profile, pref);
+  // Written to disk now: Android may stop the app at any moment, and the
+  // usual delayed write would lose the choice.
+  profile->GetPrefs()->CommitPendingWrite();
+  return RespondNow(NoArguments());
+}
+
 }  // namespace extensions

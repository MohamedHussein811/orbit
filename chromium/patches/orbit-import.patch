+// Orbit: browsers built on Chromium keep bookmarks and history in plain files
+// in each profile folder, so they are offered for import. Their passwords and
+// cookies are encrypted for that browser only and are not offered.
+struct OrbitChromiumBrowser {
+  const char16_t* name;
+  int base_key;
+  const base::FilePath::CharType* folder;
+};
+
+constexpr OrbitChromiumBrowser kOrbitChromiumBrowsers[] = {
+#if BUILDFLAG(IS_WIN)
+    {u"Google Chrome", base::DIR_LOCAL_APP_DATA,
+     FILE_PATH_LITERAL("Google\\Chrome\\User Data")},
+    {u"Microsoft Edge", base::DIR_LOCAL_APP_DATA,
+     FILE_PATH_LITERAL("Microsoft\\Edge\\User Data")},
+    {u"Brave", base::DIR_LOCAL_APP_DATA,
+     FILE_PATH_LITERAL("BraveSoftware\\Brave-Browser\\User Data")},
+    {u"Opera", base::DIR_ROAMING_APP_DATA,
+     FILE_PATH_LITERAL("Opera Software\\Opera Stable")},
+    {u"Opera GX", base::DIR_ROAMING_APP_DATA,
+     FILE_PATH_LITERAL("Opera Software\\Opera GX Stable")},
+    {u"Vivaldi", base::DIR_LOCAL_APP_DATA,
+     FILE_PATH_LITERAL("Vivaldi\\User Data")},
+    {u"Yandex Browser", base::DIR_LOCAL_APP_DATA,
+     FILE_PATH_LITERAL("Yandex\\YandexBrowser\\User Data")},
+    {u"Chromium", base::DIR_LOCAL_APP_DATA,
+     FILE_PATH_LITERAL("Chromium\\User Data")},
+#elif BUILDFLAG(IS_MAC)
+    {u"Google Chrome", base::DIR_APP_DATA, FILE_PATH_LITERAL("Google/Chrome")},
+    {u"Microsoft Edge", base::DIR_APP_DATA,
+     FILE_PATH_LITERAL("Microsoft Edge")},
+    {u"Brave", base::DIR_APP_DATA,
+     FILE_PATH_LITERAL("BraveSoftware/Brave-Browser")},
+    {u"Opera", base::DIR_APP_DATA,
+     FILE_PATH_LITERAL("com.operasoftware.Opera")},
+    {u"Opera GX", base::DIR_APP_DATA,
+     FILE_PATH_LITERAL("com.operasoftware.OperaGX")},
+    {u"Vivaldi", base::DIR_APP_DATA, FILE_PATH_LITERAL("Vivaldi")},
+    {u"Arc", base::DIR_APP_DATA, FILE_PATH_LITERAL("Arc/User Data")},
+    {u"Chromium", base::DIR_APP_DATA, FILE_PATH_LITERAL("Chromium")},
+#else
+    {u"Google Chrome", base::DIR_HOME,
+     FILE_PATH_LITERAL(".config/google-chrome")},
+    {u"Microsoft Edge", base::DIR_HOME,
+     FILE_PATH_LITERAL(".config/microsoft-edge")},
+    {u"Brave", base::DIR_HOME,
+     FILE_PATH_LITERAL(".config/BraveSoftware/Brave-Browser")},
+    {u"Opera", base::DIR_HOME, FILE_PATH_LITERAL(".config/opera")},
+    {u"Vivaldi", base::DIR_HOME, FILE_PATH_LITERAL(".config/vivaldi")},
+    {u"Chromium", base::DIR_HOME, FILE_PATH_LITERAL(".config/chromium")},
+#endif
+};
+
+constexpr size_t kOrbitMaxLocalStateBytes = 16 * 1024 * 1024;
+
+void AddOrbitChromiumProfile(
+    const std::u16string& browser,
+    const std::u16string& profile,
+    const base::FilePath& folder,
+    std::vector<user_data_importer::SourceProfile>* profiles) {
+  uint16_t services = user_data_importer::NONE;
+  if (base::PathExists(folder.AppendASCII("Bookmarks"))) {
+    services |= user_data_importer::FAVORITES;
+  }
+  if (base::PathExists(folder.AppendASCII("History"))) {
+    services |= user_data_importer::HISTORY;
+  }
+  if (services == user_data_importer::NONE) {
+    return;
+  }
+  user_data_importer::SourceProfile source;
+  source.importer_name = browser;
+  source.profile = profile;
+  source.importer_type = user_data_importer::TYPE_CHROMIUM;
+  source.source_path = folder;
+  source.services_supported = services;
+  profiles->push_back(source);
+}
+
+void DetectChromiumProfiles(
+    std::vector<user_data_importer::SourceProfile>* profiles) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  base::FilePath own_data;
+  base::PathService::Get(chrome::DIR_USER_DATA, &own_data);
+  for (const OrbitChromiumBrowser& browser : kOrbitChromiumBrowsers) {
+    base::FilePath base_folder;
+    if (!base::PathService::Get(browser.base_key, &base_folder)) {
+      continue;
+    }
+    const base::FilePath user_data = base_folder.Append(browser.folder);
+    if (user_data == own_data || !base::DirectoryExists(user_data)) {
+      continue;
+    }
+    const size_t before = profiles->size();
+    std::string local_state;
+    std::optional<base::DictValue> state;
+    if (base::ReadFileToStringWithMaxSize(user_data.AppendASCII("Local State"),
+                                          &local_state,
+                                          kOrbitMaxLocalStateBytes)) {
+      state = base::JSONReader::ReadDict(local_state, base::JSON_PARSE_RFC);
+    }
+    const base::DictValue* info =
+        state ? state->FindDictByDottedPath("profile.info_cache") : nullptr;
+    if (info) {
+      for (const auto [folder, value] : *info) {
+        // A profile is always a folder directly inside the user data folder.
+        if (folder.empty() || folder == "." || folder == ".." ||
+            folder.find_first_of("/\\") != std::string::npos) {
+          continue;
+        }
+        const base::DictValue* entry = value.GetIfDict();
+        const std::string* name = entry ? entry->FindString("name") : nullptr;
+        AddOrbitChromiumProfile(
+            browser.name, base::UTF8ToUTF16(name ? *name : folder),
+            user_data.Append(base::FilePath::FromUTF8Unsafe(folder)),
+            profiles);
+      }
+    }
+    // Opera keeps its only profile in the user data folder itself.
+    if (profiles->size() == before) {
+      AddOrbitChromiumProfile(browser.name, std::u16string(), user_data,
+                              profiles);
+    }
+    if (profiles->size() == before) {
+      AddOrbitChromiumProfile(browser.name, std::u16string(),
+                              user_data.AppendASCII("Default"), profiles);
+    }
+  }
+}

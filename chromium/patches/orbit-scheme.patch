+++ b/components/omnibox/browser/autocomplete_controller.cc
@@ -378,6 +378,30 @@
   return contextual_search_params.show_suggestions_on_no_apc;
 }
 
+// Suggestions for Orbit's internal pages read orbit://, like the address bar.
+// Choosing one still opens the chrome:// page.
+void ShowOrbitScheme(AutocompleteResult* result) {
+  for (AutocompleteMatch& match : *result) {
+    if (!match.destination_url.SchemeIs("chrome") &&
+        !AutocompleteMatch::IsSearchType(match.type)) {
+      continue;
+    }
+    if (base::StartsWith(match.contents, u"chrome://",
+                         base::CompareCase::INSENSITIVE_ASCII)) {
+      match.contents.replace(0, 6, u"orbit");
+      for (ACMatchClassification& style : match.contents_class) {
+        if (style.offset >= 6) {
+          --style.offset;
+        }
+      }
+    }
+    if (base::StartsWith(match.fill_into_edit, u"chrome://",
+                         base::CompareCase::INSENSITIVE_ASCII)) {
+      match.fill_into_edit.replace(0, 6, u"orbit");
+    }
+  }
+}
+
 }  // namespace
 

     "information and MUST not be extracted, overwritten or modified except "
     "through %s defined APIs.";
 
+// Orbit's privacy defaults for each profile, set once every service has registered its prefs.
+// They change only the default value, so a person's own choice in Settings still wins.
+base::DictValue OrbitSearchEngine(const char* name,
+                                  const char* keyword,
+                                  const char* search_url,
+                                  const char* suggest_url,
+                                  const char* favicon_url,
+                                  int id) {
+  base::DictValue engine;
+  engine.Set("name", name);
+  engine.Set("keyword", keyword);
+  engine.Set("search_url", search_url);
+  engine.Set("suggest_url", suggest_url);
+  engine.Set("favicon_url", favicon_url);
+  engine.Set("encoding", "UTF-8");
+  engine.Set("id", id);
+  return engine;
+}
+
+void SetOrbitDefault(user_prefs::PrefRegistrySyncable* registry,
+                     const char* name,
+                     base::Value value) {
+  if (!registry->defaults()->GetValue(name, nullptr)) {
+    LOG(ERROR) << "No Orbit default for unregistered pref " << name;
+    return;
+  }
+  registry->SetDefaultPrefValue(name, std::move(value));
+}
+
+void SetOrbitProfileDefaults(user_prefs::PrefRegistrySyncable* registry) {
+  base::ListValue engines;
+  engines.Append(OrbitSearchEngine(
+      "DuckDuckGo", "duckduckgo.com", "https://duckduckgo.com/?q={searchTerms}",
+      "https://duckduckgo.com/ac/?q={searchTerms}&type=list",
+      "https://duckduckgo.com/favicon.ico", 92));
+  engines.Append(OrbitSearchEngine(
+      "Google", "google.com", "https://www.google.com/search?q={searchTerms}",
+      "https://www.google.com/complete/search?client=chrome&q={searchTerms}",
+      "https://www.google.com/favicon.ico", 1));
+  engines.Append(OrbitSearchEngine(
+      "Bing", "bing.com", "https://www.bing.com/search?q={searchTerms}",
+      "https://www.bing.com/osjson.aspx?query={searchTerms}",
+      "https://www.bing.com/favicon.ico", 3));
+  engines.Append(OrbitSearchEngine(
+      "Ecosia", "ecosia.org", "https://www.ecosia.org/search?q={searchTerms}",
+      "https://ac.ecosia.org/autocomplete?q={searchTerms}&type=list",
+      "https://www.ecosia.org/favicon.ico", 101));
+  SetOrbitDefault(registry, "search_provider_overrides", base::Value(std::move(engines)));
+
+  SetOrbitDefault(registry, "profile.cookie_controls_mode", base::Value(1));
+  SetOrbitDefault(registry, "https_only_mode_enabled", base::Value(true));
+  SetOrbitDefault(registry, "safebrowsing.enabled", base::Value(false));
+  SetOrbitDefault(registry, "search.suggest_enabled", base::Value(false));
+  SetOrbitDefault(registry, "net.network_prediction_options", base::Value(2));
+  SetOrbitDefault(registry, "translate.enabled", base::Value(false));
+  SetOrbitDefault(registry, "alternate_error_pages.enabled", base::Value(false));
+  SetOrbitDefault(registry, "signin.allowed", base::Value(false));
+  SetOrbitDefault(registry, "extensions.block_external_extensions", base::Value(true));
+  SetOrbitDefault(registry, "profile.password_manager_leak_detection", base::Value(false));
+
+  // Follow the device's light or dark setting.
+  SetOrbitDefault(registry, "browser.theme.color_scheme2", base::Value(0));
+#if BUILDFLAG(IS_LINUX)
+  SetOrbitDefault(registry, "extensions.theme.system_theme", base::Value(0));
+#endif
+}

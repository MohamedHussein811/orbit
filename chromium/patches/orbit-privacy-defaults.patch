+namespace {
+
+// Orbit's default switches and features for the browser process. Other processes get their
+// feature state from the browser.
+void ApplyOrbitSwitches() {
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kProcessType)) {
+    return;
+  }
+  for (const char* name :
+       {"disable-domain-reliability", "disable-sync", "no-pings"}) {
+    command_line->AppendSwitch(name);
+  }
+  const auto merge = [command_line](const char* name, const char* values) {
+    std::string merged = command_line->GetSwitchValueASCII(name);
+    if (!merged.empty()) {
+      merged += ",";
+    }
+    command_line->AppendSwitchASCII(name, merged + values);
+  };
+  constexpr char kAiAndAdFeatures[] =
+      "AIPromptAPI,AISummarizationAPI,AIWriterAPI,AIRewriterAPI,"
+      "AIProofreadingAPI,TranslationAPI,LanguageDetectionAPI,Fledge,TopicsAPI,"
+      "AttributionReporting,FencedFrames,PrivateStateTokens,AdInterestGroupAPI";
+  merge("enable-features", "CertificateTransparencyAskBeforeEnabling");
+  merge("disable-features",
+        (std::string("AimEnabled,AimServerEligibilityEnabled,NtpFooter,"
+                     "NetworkTimeServiceQuerying,IgnoreSearchProviderOverrides,"
+                     "PrivacySandboxAdsAPIsM1Override,SharedStorageAPI,") +
+         kAiAndAdFeatures)
+            .c_str());
+  merge("disable-blink-features", kAiAndAdFeatures);
+}
+
+}  // namespace
+
 std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
   crash_reporter::InitializeCrashKeys();
+  ApplyOrbitSwitches();
 
 #if BUILDFLAG(IS_CHROMEOS)
   ash::BootTimesRecorder::Get()->SaveChromeMainStats();

+// Orbit's privacy defaults. They change only the default value, so a person's own choice in
+// Settings still wins.
+base::DictValue OrbitSearchEngine(const char* name,
+                                  const char* keyword,
+                                  const char* search_url,
+                                  const char* suggest_url,
+                                  const char* favicon_url,
+                                  int id) {
+  base::DictValue engine;
+  engine.Set("name", name);
+  engine.Set("keyword", keyword);
+  engine.Set("search_url", search_url);
+  engine.Set("suggest_url", suggest_url);
+  engine.Set("favicon_url", favicon_url);
+  engine.Set("encoding", "UTF-8");
+  engine.Set("id", id);
+  return engine;
+}
+
+void SetOrbitLocalStateDefaults(PrefRegistrySimple* registry) {
+  registry->SetDefaultPrefValue("dns_over_https.mode", base::Value("secure"));
+  registry->SetDefaultPrefValue(
+      "dns_over_https.templates",
+      base::Value("https://dns.quad9.net/dns-query"));
+}
+
+void SetOrbitProfileDefaults(user_prefs::PrefRegistrySyncable* registry) {
+  base::ListValue engines;
+  engines.Append(OrbitSearchEngine(
+      "DuckDuckGo", "duckduckgo.com", "https://duckduckgo.com/?q={searchTerms}",
+      "https://duckduckgo.com/ac/?q={searchTerms}&type=list",
+      "https://duckduckgo.com/favicon.ico", 92));
+  engines.Append(OrbitSearchEngine(
+      "Google", "google.com", "https://www.google.com/search?q={searchTerms}",
+      "https://www.google.com/complete/search?client=chrome&q={searchTerms}",
+      "https://www.google.com/favicon.ico", 1));
+  engines.Append(OrbitSearchEngine(
+      "Bing", "bing.com", "https://www.bing.com/search?q={searchTerms}",
+      "https://www.bing.com/osjson.aspx?query={searchTerms}",
+      "https://www.bing.com/favicon.ico", 3));
+  engines.Append(OrbitSearchEngine(
+      "Ecosia", "ecosia.org", "https://www.ecosia.org/search?q={searchTerms}",
+      "https://ac.ecosia.org/autocomplete?q={searchTerms}&type=list",
+      "https://www.ecosia.org/favicon.ico", 101));
+  registry->SetDefaultPrefValue("search_provider_overrides",
+                                base::Value(std::move(engines)));
+
+  registry->SetDefaultPrefValue("profile.cookie_controls_mode", base::Value(1));
+  registry->SetDefaultPrefValue("https_only_mode_enabled", base::Value(true));
+  registry->SetDefaultPrefValue("safebrowsing.enabled", base::Value(false));
+  registry->SetDefaultPrefValue("search.suggest_enabled", base::Value(false));
+  registry->SetDefaultPrefValue("net.network_prediction_options",
+                                base::Value(2));
+  registry->SetDefaultPrefValue("translate.enabled", base::Value(false));
+  registry->SetDefaultPrefValue("alternate_error_pages.enabled",
+                                base::Value(false));
+  registry->SetDefaultPrefValue("signin.allowed", base::Value(false));
+  registry->SetDefaultPrefValue("profile.password_manager_leak_detection",
+                                base::Value(false));
+}

+void AppMenuModel::RemoveRowsHiddenInSettings() {
+  const PrefService* pref_service =
+      browser_->GetProfile()->GetOriginalProfile()->GetPrefs();
+  struct Row {
+    const char* name;
+    int commands[3];
+  };
+  static constexpr Row kRows[] = {
+      {"new_tab", {IDC_NEW_TAB}},
+      {"new_window", {IDC_NEW_WINDOW}},
+      {"new_private_window", {IDC_NEW_INCOGNITO_WINDOW}},
+      {"profile", {IDC_PROFILE_MENU_IN_APP_MENU}},
+      {"passwords", {IDC_PASSWORDS_AND_AUTOFILL_MENU}},
+      {"history", {IDC_RECENT_TABS_MENU}},
+      {"downloads", {IDC_SHOW_DOWNLOADS}},
+      {"bookmarks", {IDC_BOOKMARKS_MENU}},
+      {"tab_groups", {kSavedTabGroupsMenuPlaceholder}},
+      {"extensions", {kSkillsAndExtensionsMenuPlaceholder, IDC_EXTENSIONS_SUBMENU, IDC_FIND_EXTENSIONS}},
+      {"delete_data", {IDC_CLEAR_BROWSING_DATA}},
+      {"zoom", {IDC_ZOOM_MENU}},
+      {"print", {IDC_PRINT}},
+      {"translate", {IDC_SHOW_TRANSLATE}},
+      {"find_edit", {IDC_FIND_AND_EDIT_MENU}},
+      {"save_share", {IDC_SAVE_AND_SHARE_MENU}},
+      {"more_tools", {IDC_MORE_TOOLS_MENU}},
+      {"help", {IDC_HELP_MENU, IDC_ABOUT}},
+      {"settings", {IDC_OPTIONS}},
+      {"exit", {IDC_EXIT}},
+      {"make_default", {IDC_SET_BROWSER_AS_DEFAULT}},
+  };
+  for (const Row& row : kRows) {
+    if (pref_service->GetBoolean(std::string(prefs::kOrbitMenuPrefPrefix) +
+                                 row.name)) {
+      continue;
+    }
+    for (int command : row.commands) {
+      if (!command) {
+        continue;
+      }
+      if (std::optional<size_t> index = GetIndexOfCommandId(command)) {
+        RemoveItemAt(*index);
+      }
+    }
+  }
+  // No separator at either end of the menu or next to another one.
+  for (size_t i = GetItemCount(); i > 0; --i) {
+    const size_t index = i - 1;
+    if (GetTypeAt(index) != ui::MenuModel::TYPE_SEPARATOR) {
+      continue;
+    }
+    const bool at_edge = index == 0 || index + 1 == GetItemCount();
+    const bool doubled = index + 1 < GetItemCount() &&
+                         GetTypeAt(index + 1) == ui::MenuModel::TYPE_SEPARATOR;
+    if (at_edge || doubled) {
+      RemoveItemAt(index);
+    }
+  }
+}

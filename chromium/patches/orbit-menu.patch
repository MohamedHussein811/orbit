+// Copyright 2026 NovaTech
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-orbit-menu-page' is Settings > Appearance > Customize
+ * menu: a switch for each row of the app menu.
+ */
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_subpage.js';
+
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {SettingsViewMixinLit} from '../settings_page/settings_view_mixin_lit.js';
+
+import {getCss} from './orbit_menu_page.css.js';
+import {getHtml} from './orbit_menu_page.html.js';
+
+/** The menu's rows, in the menu's order (prefs::kOrbitMenuRows). */
+const ROWS: string[] = [
+  'new_tab',
+  'new_window',
+  'new_private_window',
+  'profile',
+  'passwords',
+  'history',
+  'downloads',
+  'bookmarks',
+  'tab_groups',
+  'extensions',
+  'delete_data',
+  'zoom',
+  'print',
+  'translate',
+  'find_edit',
+  'save_share',
+  'more_tools',
+  'help',
+  'settings',
+  'exit',
+  'make_default',
+];
+
+const SettingsOrbitMenuPageElementBase = SettingsViewMixinLit(CrLitElement);
+
+export class SettingsOrbitMenuPageElement extends
+    SettingsOrbitMenuPageElementBase {
+  static get is() {
+    return 'settings-orbit-menu-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      rows_: {type: Array},
+    };
+  }
+
+  protected accessor rows_: string[] = ROWS;
+
+  protected prefKey_(row: string): string {
+    return `orbit.menu.${row}`;
+  }
+
+  protected label_(row: string): string {
+    return loadTimeData.getString(`orbitMenu_${row}`);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-orbit-menu-page': SettingsOrbitMenuPageElement;
+  }
+}
+
+customElements.define(
+    SettingsOrbitMenuPageElement.is, SettingsOrbitMenuPageElement);

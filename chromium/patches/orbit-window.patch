+// Orbit's address bar keeps this width in the toolbar row; the tabs take the
+// rest, and always keep at least the minimum.
+constexpr int kOrbitLocationBarWidth = 480;
+constexpr int kOrbitMinimumTabSlotWidth = 160;
+
+gfx::Size OrbitLocationBarSize(const views::View* view,
+                               const views::SizeBounds& maximum_size) {
+  const int width =
+      std::max(maximum_size.width().min_of(kOrbitLocationBarWidth),
+               view->GetMinimumSize().width());
+  return gfx::Size(width, view->GetPreferredSize().height());
+}
+
+// Orbit's horizon: a thin line under the toolbar row that runs from periwinkle
+// through the amber and rose of the black hole's disk.
+class OrbitHorizonBackground : public views::Background {
+ public:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    const gfx::Rect bounds = view->GetLocalBounds();
+    const SkPoint points[] = {SkPoint::Make(bounds.x(), 0),
+                              SkPoint::Make(bounds.right(), 0)};
+    const SkColor4f colors[] = {
+        SkColor4f::FromColor(SkColorSetARGB(0x1A, 0x9E, 0xAC, 0xFF)),
+        SkColor4f::FromColor(SkColorSetARGB(0x8C, 0xFF, 0xB3, 0x6B)),
+        SkColor4f::FromColor(SkColorSetARGB(0xB3, 0xFF, 0x5D, 0x73)),
+        SkColor4f::FromColor(SkColorSetARGB(0xFF, 0x9E, 0xAC, 0xFF)),
+        SkColor4f::FromColor(SkColorSetARGB(0x1A, 0x9E, 0xAC, 0xFF))};
+    const SkScalar positions[] = {0.f, 0.38f, 0.48f, 0.6f, 1.f};
+    cc::PaintFlags flags;
+    flags.setShader(cc::PaintShader::MakeLinearGradient(
+        points, colors, positions, 5, SkTileMode::kClamp));
+    canvas->DrawRect(bounds, flags);
+  }
+};

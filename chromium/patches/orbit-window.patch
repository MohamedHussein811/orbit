 ///////////////////////////////////////////////////////////////////////////////
 // BrowserView, views::View overrides:
 
+void BrowserView::UpdateOrbitRail() {
+  SidePanelUI* const ui = SidePanelUI::From(browser_.get());
+  if (!orbit_rail_ || !ui) {
+    return;
+  }
+  // Switching panels does not always change the layout, so lay out again when
+  // a panel shows.
+  if (!orbit_side_panel_shown_subscription_) {
+    orbit_side_panel_shown_subscription_ =
+        ui->RegisterSidePanelShown(base::BindRepeating(
+            [](views::View* view) { view->InvalidateLayout(); },
+            base::Unretained(this)));
+  }
+  for (views::View* const child : orbit_rail_->children()) {
+    std::optional<SidePanelEntryKey> key;
+    if (child->GetID() == kOrbitRailBookmarksViewId) {
+      key.emplace(SidePanelEntryId::kBookmarks);
+    } else if (child->GetID() == kOrbitRailNotesViewId) {
+      key.emplace(SidePanelEntryId::kExtension, kOrbitExtensionId);
+    }
+    if (!key) {
+      continue;
+    }
+    views::InkDrop* const ink_drop = views::InkDrop::Get(child)->GetInkDrop();
+    const bool showing = ui->IsSidePanelEntryShowing(*key);
+    const views::InkDropState current = ink_drop->GetTargetInkDropState();
+    if (showing && current != views::InkDropState::ACTIVATED) {
+      ink_drop->AnimateToState(views::InkDropState::ACTIVATED);
+    } else if (!showing && current == views::InkDropState::ACTIVATED) {
+      ink_drop->AnimateToState(views::InkDropState::DEACTIVATED);
+    }
+  }
+}

+// Orbit's rail: a column on the leading edge of the window, below the toolbar
+// row, with Orbit's mark and the places people return to.
+std::unique_ptr<views::View> CreateOrbitRail(BrowserWindowInterface* browser) {
+  auto rail = std::make_unique<views::View>();
+  rail->SetBackground(views::CreateSolidBackground(kColorToolbar));
+  auto* const layout =
+      rail->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(10, 8),
+          6));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  rail->GetViewAccessibility().SetRole(ax::mojom::Role::kToolbar);
+  rail->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_PRODUCT_NAME));
+
+  auto* const mark = rail->AddChildView(
+      std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+          vector_icons::kProductRefreshIcon, kColorToolbarButtonIcon, 22)));
+  mark->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(4, 0, 10, 0));
+  mark->GetViewAccessibility().SetIsIgnored(true);
+
+  const auto add_button = [&](const gfx::VectorIcon& icon,
+                              const std::u16string& name,
+                              base::RepeatingClosure action) {
+    auto* const button =
+        rail->AddChildView(std::make_unique<ToolbarButton>(std::move(action)));
+    button->SetVectorIcon(icon);
+    button->SetTooltipText(name);
+  };
+  const auto command = [browser](int id) {
+    return base::BindRepeating(
+        [](BrowserWindowInterface* browser, int id) {
+          chrome::ExecuteCommand(browser, id);
+        },
+        browser, id);
+  };
+  const auto side_panel = [browser](SidePanelEntryKey key) {
+    return base::BindRepeating(
+        [](BrowserWindowInterface* browser, const SidePanelEntryKey& key) {
+          if (SidePanelUI* const ui = SidePanelUI::From(browser)) {
+            ui->Toggle(key, SidePanelOpenTrigger::kToolbarButton);
+          }
+        },
+        browser, std::move(key));
+  };
+  const auto name = [](int id) { return l10n_util::GetStringUTF16(id); };
+
+  // Orbit's own pages and panels live in its built-in extension. Its notes
+  // name comes from Orbit's two translations, since Chromium has no such
+  // string.
+  constexpr char kOrbitExtensionId[] = "kceipbaiojomdibnboffoieecidpfdck";
+  const bool arabic = base::StartsWith(
+      g_browser_process->GetApplicationLocale(), "ar",
+      base::CompareCase::SENSITIVE);
+  const std::u16string notes_name =
+      arabic ? u"\u0627\u0644\u0645\u0644\u0627\u062D\u0638\u0627\u062A"
+             : u"Notes";
+
+  add_button(kNavigateHomeChromeRefreshOldIcon,
+             name(IDS_OVERFLOW_MENU_ITEM_TEXT_HOME), command(IDC_HOME));
+  add_button(kOrbitRailShieldsIcon,
+             name(IDS_OPTIONS_ADVANCED_SECTION_TITLE_PRIVACY),
+             base::BindRepeating(
+                 [](BrowserWindowInterface* browser, const std::string& id) {
+                   ShowSingletonTab(
+                       browser, GURL(base::StrCat({"chrome-extension://", id,
+                                                   "/privacy/privacy.html"})));
+                 },
+                 browser, std::string(kOrbitExtensionId)));
+  add_button(kOrbitRailBookmarksIcon, name(IDS_BOOKMARK_MANAGER_TITLE),
+             side_panel(SidePanelEntryKey(SidePanelEntryId::kBookmarks)));
+  add_button(kOrbitRailHistoryIcon, name(IDS_HISTORY_TITLE),
+             command(IDC_SHOW_HISTORY));
+  add_button(kDownloadToolbarButtonChromeRefreshOldIcon,
+             name(IDS_OVERFLOW_MENU_ITEM_TEXT_DOWNLOADS),
+             command(IDC_SHOW_DOWNLOADS));
+  add_button(kOrbitRailNotesIcon, notes_name,
+             side_panel(SidePanelEntryKey(SidePanelEntryId::kExtension,
+                                          kOrbitExtensionId)));
+  layout->SetFlexForView(rail->AddChildView(std::make_unique<views::View>()),
+                         1);
+  add_button(kOrbitRailSettingsIcon, name(IDS_SETTINGS_SETTINGS),
+             command(IDC_OPTIONS));
+  return rail;
+}

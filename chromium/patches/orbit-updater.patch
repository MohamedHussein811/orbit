+
+#ifndef CHROME_BROWSER_UI_WEBUI_HELP_ORBIT_UPDATE_CHECK_H_
+#define CHROME_BROWSER_UI_WEBUI_HELP_ORBIT_UPDATE_CHECK_H_
+
+#include "base/functional/callback.h"
+
+namespace orbit {
+
+// Where an update check asked for by the About page stands.
+enum class UpdateCheckStatus {
+  kChecking,
+  kDownloading,
+  kInstalled,
+  kUpToDate,
+  kFailed,
+  kUnavailable,
+};
+
+// |progress| is the download's percentage; |error| names the failed step.
+using UpdateCheckCallback = base::RepeatingCallback<
+    void(UpdateCheckStatus status, int progress, int error)>;
+using UpdateCheckFunction = void (*)(UpdateCheckCallback callback);
+
+// Orbit's updater registers how to check now; the About page calls it. Without one (system-wide
+// installs, builds run from their own folder) the About page shows no update status.
+void SetUpdateCheckFunction(UpdateCheckFunction function);
+UpdateCheckFunction GetUpdateCheckFunction();
+
+}  // namespace orbit
+
+#endif  // CHROME_BROWSER_UI_WEBUI_HELP_ORBIT_UPDATE_CHECK_H_

+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ORBIT_UPDATER_WIN_H_
+#define CHROME_BROWSER_ORBIT_UPDATER_WIN_H_
+
+namespace orbit {
+
+// Keeps a per-user Orbit install up to date. A few minutes after start and then every few hours,
+// it reads Orbit's release feed, checks the feed's Ed25519 signature against the key built into
+// Orbit, downloads a newer setup, checks its size and SHA-256 against the feed, and runs it
+// silently. The setup installs next to the running copy; the menu then offers to relaunch.
+// Turned off by --disable-background-networking, by system-wide installs (updated by their
+// administrators), and by the "Enabled" value 0 under HKCU\Software\NovaTech\Orbit Update,
+// which Orbit's setup writes when the person turns automatic updates off.
+void StartUpdater();
+void StopUpdater();
+
+}  // namespace orbit
+
+#endif  // CHROME_BROWSER_ORBIT_UPDATER_WIN_H_

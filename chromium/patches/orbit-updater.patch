+namespace {
+
+// The About page's update section, driven by Orbit's own updater.
+class VersionUpdaterOrbit : public VersionUpdater {
+ public:
+  VersionUpdaterOrbit() = default;
+  VersionUpdaterOrbit(const VersionUpdaterOrbit&) = delete;
+  VersionUpdaterOrbit& operator=(const VersionUpdaterOrbit&) = delete;
+  ~VersionUpdaterOrbit() override = default;
+
+  void CheckForUpdate(StatusCallback callback, PromoteCallback) override {
+    callback_ = std::move(callback);
+    if (UpgradeDetector::GetInstance()->is_upgrade_available()) {
+      Report(NEARLY_UPDATED, 0, std::u16string());
+      return;
+    }
+    orbit::UpdateCheckFunction check = orbit::GetUpdateCheckFunction();
+    if (!check) {
+      Report(DISABLED, 0, std::u16string());
+      return;
+    }
+    check(base::BindRepeating(&VersionUpdaterOrbit::OnStatus,
+                              weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnStatus(orbit::UpdateCheckStatus status, int progress, int error) {
+    switch (status) {
+      case orbit::UpdateCheckStatus::kChecking:
+        Report(CHECKING, 0, std::u16string());
+        break;
+      case orbit::UpdateCheckStatus::kDownloading:
+        Report(UPDATING, progress, std::u16string());
+        break;
+      case orbit::UpdateCheckStatus::kInstalled:
+        Report(NEARLY_UPDATED, 0, std::u16string());
+        break;
+      case orbit::UpdateCheckStatus::kUpToDate:
+        Report(UPDATED, 0, std::u16string());
+        break;
+      case orbit::UpdateCheckStatus::kFailed:
+        Report(FAILED, 0, l10n_util::GetStringFUTF16Int(IDS_UPGRADE_ERROR, error));
+        break;
+      case orbit::UpdateCheckStatus::kUnavailable:
+        Report(DISABLED, 0, std::u16string());
+        break;
+    }
+  }
+
+  void Report(Status status, int progress, const std::u16string& message) {
+    callback_.Run(status, progress, false, false, std::string(), 0, message);
+  }
+
+  StatusCallback callback_;
+  base::WeakPtrFactory<VersionUpdaterOrbit> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(
+    content::WebContents* web_contents) {
+  return std::make_unique<VersionUpdaterOrbit>();
+}

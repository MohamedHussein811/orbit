   auto* const build_state = g_browser_process->GetBuildState();
   build_state->AddObserver(this);
   installed_version_poller_.emplace(build_state);
+#else
+  // Orbit: notice a newer installed version (from Orbit's updater, a package manager or a manual
+  // install) and offer to relaunch, without the outdated-build bubble, which points to Google.
+  auto* const build_state = g_browser_process->GetBuildState();
+  build_state->AddObserver(this);
+  installed_version_poller_.emplace(build_state);
 #endif  // BUILDFLAG(ENABLE_UPDATE_NOTIFICATIONS)
 }
 

diff --git a/chrome/browser/resources/new_tab_page_incognito_guest/incognito_tab.css b/chrome/browser/resources/new_tab_page_incognito_guest/incognito_tab.css
--- a/chrome/browser/resources/new_tab_page_incognito_guest/incognito_tab.css
+++ b/chrome/browser/resources/new_tab_page_incognito_guest/incognito_tab.css
@@ -322,3 +322,30 @@
     padding-inline-start: 24px;
   }
 }
+
+/* Orbit private window. */
+html:not([hascustombackground='true']) {
+  background:
+    radial-gradient(70rem 32rem at 50% -12rem, rgb(141 155 255 / 0.2), transparent 70%),
+    #131418;
+}
+
+.content {
+  color: #c4c6ce;
+}
+
+h1,
+em {
+  color: #e1e3e7;
+}
+
+#cookie-controls {
+  background-color: #24252c;
+  border: 1px solid rgb(224 226 237 / 0.1);
+  border-radius: 16px;
+}
+
+.learn-more-button,
+#cookie-controls-description a {
+  color: #9eacff;
+}
diff --git a/components/security_interstitials/core/common/resources/interstitial_core.css b/components/security_interstitials/core/common/resources/interstitial_core.css
--- a/components/security_interstitials/core/common/resources/interstitial_core.css
+++ b/components/security_interstitials/core/common/resources/interstitial_core.css
@@ -81,3 +81,66 @@
     --text-color: var(--google-gray-500);
   }
 }
+
+/* Orbit's palette, shared by error pages and security warnings. */
+body {
+  --background-color: #f6f7fd;
+  --error-code-color: #6f778b;
+  --heading-color: #171b2c;
+  --link-color: #4c52ba;
+  --primary-button-fill-color-active: #3d43a3;
+  --primary-button-fill-color: #4c52ba;
+  --primary-button-text-color: #fff;
+  --quiet-background-color: #f6f7fd;
+  --secondary-button-border-color: #c6cadb;
+  --secondary-button-fill-color: #fff;
+  --secondary-button-hover-border-color: #8b91a8;
+  --secondary-button-hover-fill-color: #eef0fb;
+  --secondary-button-text-color: #4c52ba;
+  --small-link-color: #4c52ba;
+  --text-color: #3f465e;
+}
+
+@media (prefers-color-scheme: dark) {
+  body {
+    --background-color: #1a1c22;
+    --error-code-color: #8e9099;
+    --heading-color: #e1e3e7;
+    --link-color: #9eacff;
+    --primary-button-fill-color-active: #b8c2ff;
+    --primary-button-fill-color: #9eacff;
+    --primary-button-text-color: #261e84;
+    --quiet-background-color: #1a1c22;
+    --secondary-button-border-color: #44464e;
+    --secondary-button-fill-color: #1a1c22;
+    --secondary-button-hover-border-color: #5d6068;
+    --secondary-button-hover-fill-color: #282930;
+    --secondary-button-text-color: #9eacff;
+    --small-link-color: #9eacff;
+    --text-color: #c4c6ce;
+  }
+}
+
+html:has(body:not(.safe-browsing):not(.ssl):not(.lookalike-url):not(.enterprise-block)) {
+  min-height: 100%;
+  background:
+    radial-gradient(60rem 28rem at 50% -12rem, rgb(141 155 255 / 0.14), transparent 70%),
+    #f6f7fd;
+}
+
+@media (prefers-color-scheme: dark) {
+  html:has(body:not(.safe-browsing):not(.ssl):not(.lookalike-url):not(.enterprise-block)) {
+    background:
+      radial-gradient(60rem 28rem at 50% -12rem, rgb(141 155 255 / 0.14), transparent 70%),
+      #1a1c22;
+  }
+}
+
+body:not(.safe-browsing):not(.ssl):not(.lookalike-url):not(.enterprise-block) {
+  background: transparent;
+}
+
+h1 {
+  font-weight: 400;
+  letter-spacing: -0.01em;
+}

 bool MediaFoundationAudioDecoder::NeedsBitstreamConversion() const {
-  // DTS does not require any header/bit stream conversion
-  return false;
+  // AAC, other than xHE-AAC, reaches Media Foundation as ADTS frames, as MP4 in
+  // Media Source already does. DTS needs no conversion.
+  return config_.codec() == AudioCodec::kAAC &&
+         config_.profile() != AudioCodecProfile::kXHE_AAC;
 }
 

+// Media Source delivers AAC with ADTS headers, which AudioConverter does not
+// take; frames from other demuxers have none.
+size_t AdtsHeaderSize(const DecoderBuffer& buffer) {
+  const auto data = base::span(buffer);
+  if (data.size() < 7 || data[0] != 0xFF || (data[1] & 0xF6) != 0xF0) {
+    return 0;
+  }
+  const size_t header_size = (data[1] & 0x01) ? 7 : 9;
+  return data.size() > header_size ? header_size : 0;
+}

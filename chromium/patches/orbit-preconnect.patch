+// Orbit: connect early to the search engine of a search being typed.
+constexpr base::TimeDelta kOrbitSearchPreconnectInterval = base::Seconds(8);
+
+constexpr net::NetworkTrafficAnnotationTag kOrbitSearchPreconnectAnnotation =
+    net::DefineNetworkTrafficAnnotation("orbit_search_preconnect", R"(
+      semantics {
+        sender: "Orbit address bar"
+        description:
+          "Opens a connection to the search engine while a search is typed "
+          "in the address bar, so the results load sooner once it is "
+          "submitted."
+        trigger:
+          "Typing a search in the address bar, at most once every eight "
+          "seconds."
+        data: "None. Only a connection is opened; nothing typed is sent."
+        destination: OTHER
+        destination_other: "The search engine the search would go to."
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "None."
+        policy_exception_justification: "Opens a connection only."
+      })");
+
+void OrbitPreconnectToSearch(Profile* profile,
+                             const AutocompleteMatch& match) {
+  if (!AutocompleteMatch::IsSearchType(match.type) ||
+      !match.destination_url.SchemeIs(url::kHttpsScheme)) {
+    return;
+  }
+  static base::TimeTicks last_preconnect;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!last_preconnect.is_null() &&
+      now - last_preconnect < kOrbitSearchPreconnectInterval) {
+    return;
+  }
+  last_preconnect = now;
+  const url::Origin origin = url::Origin::Create(match.destination_url);
+  profile->GetDefaultStoragePartition()->GetNetworkContext()->PreconnectSockets(
+      /*num_streams=*/1, origin.GetURL(),
+      network::mojom::CredentialsMode::kInclude,
+      net::NetworkAnonymizationKey::CreateSameSite(net::SchemefulSite(origin)),
+      network::GetNoOpNetworkRestrictionsId(),
+      net::MutableNetworkTrafficAnnotationTag(kOrbitSearchPreconnectAnnotation),
+      /*keepalive_config=*/std::nullopt, mojo::NullRemote());
+}

+// Space is Orbit's own palette in dark mode, Dark is the grey palette in dark mode, and Light and
+// the device setting use Orbit's palette.
+void AppearanceHandler::HandleSetOrbitTheme(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  const std::string& theme = args[0].GetString();
+  ThemeService* service = ThemeServiceFactory::GetForProfile(profile_);
+  using Scheme = ThemeService::BrowserColorScheme;
+  if (theme == "dark") {
+    service->SetIsGrayscale(true);
+    service->SetBrowserColorScheme(Scheme::kDark);
+  } else {
+    service->UseDefaultTheme();
+    service->SetBrowserColorScheme(theme == "space"   ? Scheme::kDark
+                                   : theme == "light" ? Scheme::kLight
+                                                      : Scheme::kSystem);
+  }
+  settings_utils::MaybeNotifySettingsCustomEvent(
+      web_ui(), settings::kAppearanceThemeChangedId);
+}
+
+void AppearanceHandler::HandleGetOrbitTheme(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  ThemeService* service = ThemeServiceFactory::GetForProfile(profile_);
+  using Scheme = ThemeService::BrowserColorScheme;
+  const Scheme scheme = service->GetBrowserColorScheme();
+  const char* theme = scheme == Scheme::kLight  ? "light"
+                      : scheme == Scheme::kDark ? "space"
+                                                : "system";
+  if (scheme == Scheme::kDark && service->GetIsGrayscale()) {
+    theme = "dark";
+  }
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], base::Value(theme));
+}

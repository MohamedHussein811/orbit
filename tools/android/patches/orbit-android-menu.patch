+    /** The Customize menu row (Settings > Appearance) that hides a menu item, if any. */
+    private static @Nullable String orbitMenuRow(int menuItemId) {
+        if (menuItemId == R.id.new_tab_menu_id) return "new_tab";
+        if (menuItemId == R.id.new_window_menu_id) return "new_window";
+        if (menuItemId == R.id.new_incognito_tab_menu_id || menuItemId == R.id.new_incognito_window_menu_id) return "new_private_window";
+        if (menuItemId == R.id.passwords_and_autofill_parent_menu_id || menuItemId == R.id.google_password_manager_menu_id) return "passwords";
+        if (menuItemId == R.id.history_parent_menu_id || menuItemId == R.id.open_history_menu_id || menuItemId == R.id.recent_tabs_menu_id) return "history";
+        if (menuItemId == R.id.downloads_menu_id) return "downloads";
+        if (menuItemId == R.id.all_bookmarks_menu_id) return "bookmarks";
+        if (menuItemId == R.id.add_to_group_menu_id) return "tab_groups";
+        if (menuItemId == R.id.extensions_menu_menu_id || menuItemId == R.id.extensions_parent_menu_id) return "extensions";
+        if (menuItemId == R.id.quick_delete_menu_id) return "delete_data";
+        if (menuItemId == R.id.page_zoom_id) return "zoom";
+        if (menuItemId == R.id.print_id) return "print";
+        if (menuItemId == R.id.translate_id) return "translate";
+        if (menuItemId == R.id.find_in_page_id) return "find_edit";
+        if (menuItemId == R.id.save_and_share_parent_menu_id || menuItemId == R.id.share_menu_id || menuItemId == R.id.download_page_id) return "save_share";
+        if (menuItemId == R.id.more_tools_menu_id) return "more_tools";
+        if (menuItemId == R.id.help_parent_menu_id || menuItemId == R.id.help_id) return "help";
+        if (menuItemId == R.id.default_browser_promo_menu_id) return "make_default";
+        return null;
+    }
+
+    /** Removes the rows switched off in Customize menu, then any divider left first, last or doubled. */
+    private void removeRowsHiddenInSettings(MVCListAdapter.ModelList modelList) {
+        Profile profile = getProfileFromTabModel();
+        if (profile == null) return;
+        PrefService prefs = UserPrefs.get(profile);
+        for (int i = modelList.size() - 1; i >= 0; i--) {
+            PropertyModel model = modelList.get(i).model;
+            if (!model.getAllProperties().contains(AppMenuItemProperties.MENU_ITEM_ID)) continue;
+            String row = orbitMenuRow(model.get(AppMenuItemProperties.MENU_ITEM_ID));
+            if (row != null && !prefs.getBoolean(OrbitMenuSettingsFragment.PREF_PREFIX + row)) {
+                modelList.removeAt(i);
+            }
+        }
+        for (int i = modelList.size() - 1; i >= 0; i--) {
+            if (modelList.get(i).type != AppMenuHandler.AppMenuItemType.DIVIDER) continue;
+            if (i == 0
+                    || i == modelList.size() - 1
+                    || modelList.get(i - 1).type == AppMenuHandler.AppMenuItemType.DIVIDER) {
+                modelList.removeAt(i);
+            }
+        }
+    }

+/** Settings > Appearance > Customize menu: a switch for each row of the app menu. */
+@NullMarked
+public class OrbitMenuSettingsFragment extends ChromeBaseSettingsFragment {
+    /** The rows' boolean prefs are this prefix plus the row name, as on desktop. */
+    public static final String PREF_PREFIX = "orbit.menu.";
+
+    private static final String[] ROWS = {
+        "new_tab",
+        "new_window",
+        "new_private_window",
+        "passwords",
+        "history",
+        "downloads",
+        "bookmarks",
+        "tab_groups",
+        "extensions",
+        "delete_data",
+        "zoom",
+        "print",
+        "translate",
+        "find_edit",
+        "save_share",
+        "more_tools",
+        "help",
+        "make_default",
+    };
+
+    private static final int[] TITLES = {
+        R.string.menu_new_tab,
+        R.string.menu_new_window,
+        R.string.menu_new_incognito_tab,
+        R.string.menu_passwords_and_autofill,
+        R.string.menu_history,
+        R.string.menu_downloads,
+        R.string.menu_bookmarks,
+        R.string.menu_add_tab_to_group,
+        R.string.menu_extensions,
+        R.string.menu_quick_delete,
+        R.string.page_zoom_menu_title,
+        R.string.menu_print,
+        R.string.menu_translate,
+        R.string.menu_find_in_page,
+        R.string.menu_save_and_share,
+        R.string.menu_more_tools,
+        R.string.menu_help_center,
+        R.string.make_chrome_default,
+    };
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.orbit_settings_customize_menu));
+        Context context = getPreferenceManager().getContext();
+        PreferenceScreen screen = getPreferenceManager().createPreferenceScreen(context);
+        setPreferenceScreen(screen);
+
+        PrefService prefs = UserPrefs.get(getProfile());
+        for (int i = 0; i < ROWS.length; i++) {
+            String pref = PREF_PREFIX + ROWS[i];
+            ChromeSwitchPreference row = new ChromeSwitchPreference(context);
+            row.setKey(pref);
+            row.setPersistent(false);
+            row.setTitle(getString(TITLES[i]).replace("…", "").trim());
+            row.setChecked(prefs.getBoolean(pref));
+            row.setOnPreferenceChangeListener(
+                    (preference, value) -> {
+                        prefs.setBoolean(pref, (Boolean) value);
+                        return true;
+                    });
+            screen.addPreference(row);
+        }
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    public static final ChromeBaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new ChromeBaseSearchIndexProvider(
+                    OrbitMenuSettingsFragment.class.getName(),
+                    ChromeBaseSearchIndexProvider.INDEX_OPT_OUT);
+}

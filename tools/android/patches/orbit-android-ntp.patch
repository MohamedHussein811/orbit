+    /** Loads Orbit's new tab page (chrome://newtab) in place of the current entry. */
+    private static void replaceWithOrbitNewTabPage(Tab tab) {
+        PostTask.postTask(
+                TaskTraits.UI_DEFAULT,
+                () -> {
+                    if (tab.isDestroyed()) return;
+                    LoadUrlParams params =
+                            new LoadUrlParams(
+                                    UrlConstants.NTP_NON_NATIVE_URL, PageTransition.AUTO_TOPLEVEL);
+                    params.setShouldReplaceCurrentEntry(true);
+                    tab.loadUrl(params);
+                });
+    }

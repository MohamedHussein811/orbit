+    private static boolean isBrowserWindowPending() {
+        for (Activity activity : ApplicationStatus.getRunningActivities()) {
+            if (IntentUtils.safeHasExtra(
+                    activity.getIntent(),
+                    ChromeAndroidTaskTracker.EXTRA_PENDING_BROWSER_WINDOW_TASK_ID)) {
+                return true;
+            }
+        }
+        return false;
+    }

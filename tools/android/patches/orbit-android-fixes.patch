+    private boolean isPendingIncognitoBrowserWindow() {
+        Intent intent = getIntent();
+        return IntentUtils.safeHasExtra(
+                        intent, ChromeAndroidTaskTracker.EXTRA_PENDING_BROWSER_WINDOW_TASK_ID)
+                && IntentUtils.safeGetBooleanExtra(
+                        intent, IntentHandler.EXTRA_OPEN_NEW_INCOGNITO_WINDOW, false);
+    }

+
+    @Override
+    public void removeObserver(ButtonDataObserver obs) {
+        mObservers.removeObserver(obs);
+    }
+
+    @Override
+    public @Nullable ButtonData get(@Nullable Tab tab) {
+        return mButtonData;
+    }
+
+    @Override
+    public void destroy() {
+        if (mDestroyed) return;
+        destroyBridge();
+        mCurrentTabSupplier.removeObserver(mTabObserver);
+        mDestroyed = true;
+        mObservers.clear();
+    }
+
+    @Override
+    public void onAddedToTask(InitInfo initInfo) {}
+
+    @Override
+    public void onFeatureRemoved() {
+        destroyBridge();
+    }
+
+    private void onCurrentTabChanged() {
+        if (mBridge == null) maybeCreateBridge();
+        refresh();
+    }
+
+    private void maybeCreateBridge() {
+        ChromeAndroidTask task = mTask;
+        if (mDestroyed || mBridge != null || !mNativeInitialized || task == null) return;
+        if (task.isDestroyed()) return;
+        TabModelSelector selector = mTabModelSelectorSupplier.get();
+        if (selector == null) return;
+        Profile profile = selector.getCurrentModel().getProfile();
+        if (profile == null || !ExtensionUi.isEnabled(profile)) return;
+        ActivityWindowAndroid activityWindow =
+                mWindowAndroid instanceof ActivityWindowAndroid window ? window : null;
+        ChromeAndroidTaskFeature added =
+                task.addFeature(
+                        new ChromeAndroidTaskFeatureKey(
+                                OrbitShieldsButtonImpl.class, profile, activityWindow),
+                        () -> this);
+        if (added != this) return;
+        ExtensionsToolbarBridge bridge = new ExtensionsToolbarBridge(task, profile);
+        bridge.setActionListDelegate(mActionListDelegate);
+        bridge.setMenuDelegate(() -> {});
+        bridge.addObserver(mBridgeObserver);
+        mBridge = bridge;
+        refresh();
+    }
+
+    private void destroyBridge() {
+        closePopup();
+        ExtensionsToolbarBridge bridge = mBridge;
+        if (bridge == null) return;
+        mBridge = null;
+        bridge.removeObserver(mBridgeObserver);
+        bridge.setActionListDelegate(null);
+        bridge.setMenuDelegate(null);
+        bridge.destroy();
+        refresh();
+    }
+
+    private void refresh() {
+        if (mDestroyed) return;
+        ButtonData data = computeButtonData();
+        if (data == null && mButtonData == null) return;
+        mButtonData = data;
+        boolean canShow = data != null && data.canShow();
+        for (ButtonDataObserver observer : mObservers) {
+            observer.buttonDataChanged(canShow);
+        }
+    }
+
+    private @Nullable ButtonData computeButtonData() {
+        ExtensionsToolbarBridge bridge = mBridge;
+        Tab tab = mCurrentTabSupplier.get();
+        if (bridge == null || tab == null) return null;
+        // The native toolbar dereferences the action without a check, and Orbit's action exists
+        // only once the built-in extension is installed and the actions are initialized.
+        if (!hasOrbitAction(bridge)) return null;
+        WebContents webContents = tab.getWebContents();
+        ExtensionAction action = bridge.getAction(ACTION_ID, webContents);
+        if (action == null) return null;
+        Bitmap icon =
+                ExtensionActionIconUtil.getIcon(
+                        mActivity, mWindowAndroid, bridge, ACTION_ID, webContents);
+        if (icon == null) return null;
+        BitmapDrawable drawable = mDrawable;
+        if (drawable == null || mIcon == null || !mIcon.sameAs(icon)) {
+            mIcon = icon;
+            drawable = new BitmapDrawable(mActivity.getResources(), icon);
+            mDrawable = drawable;
+        }
+        ButtonData.ButtonSpec spec =
+                new ButtonData.ButtonSpec.Builder(
+                                drawable, action.getAccessibleName(), /* supportsTinting= */ false)
+                        .setOnClickListener(this::onClick)
+                        .build();
+        return new ButtonDataImpl(/* canShow= */ true, /* isEnabled= */ true, spec);
+    }
+
+    private static boolean hasOrbitAction(ExtensionsToolbarBridge bridge) {
+        return Arrays.asList(bridge.getAllActionIds()).contains(ACTION_ID);
+    }
+
+    private void onClick(View view) {
+        ExtensionsToolbarBridge bridge = mBridge;
+        if (bridge == null || !hasOrbitAction(bridge)) return;
+        if (mPopup != null) {
+            closePopup();
+            return;
+        }
+        mAnchorView = view;
+        bridge.executeUserAction(ACTION_ID, InvocationSource.TOOLBAR_BUTTON);
+    }
+
+    private void showPopup(
+            String actionId, ExtensionActionPopupContents contents, boolean inspectWithDevTools) {
+        closePopup();
+        View anchor = mAnchorView;
+        TabModelSelector selector = mTabModelSelectorSupplier.get();
+        if (mDestroyed || anchor == null || selector == null || !anchor.isAttachedToWindow()) {
+            contents.destroy();
+            return;
+        }
+        ExtensionActionPopup popup =
+                new ExtensionActionPopup(
+                        mActivity,
+                        mWindowAndroid,
+                        anchor,
+                        actionId,
+                        contents,
+                        /* contextMenuPopulatorFactory= */ null,
+                        /* selectionDropdownMenuDelegate= */ null,
+                        selector,
+                        inspectWithDevTools);
+        mPopup = popup;
+        popup.addOnDismissListener(this::closePopup);
+        popup.loadInitialPage();
+    }
+
+    private void closePopup() {
+        ExtensionActionPopup popup = mPopup;
+        if (popup == null) return;
+        mPopup = null;
+        popup.destroy();
+    }
+}

+/**
+ * Orbit Shields in the optional button slot of the phone toolbar.
+ *
+ * <p>Always compiled, like {@link ExtensionsToolbarCoordinator}; the implementation exists only
+ * when extensions are compiled.
+ */
+@NullMarked
+public interface OrbitShieldsButton extends ButtonDataProvider {
+    /** Returns the button, or null when extensions are not compiled. */
+    static @Nullable OrbitShieldsButton maybeCreate(
+            Activity activity,
+            WindowAndroid windowAndroid,
+            OneshotSupplier<ChromeAndroidTask> taskSupplier,
+            Supplier<@Nullable TabModelSelector> tabModelSelectorSupplier,
+            NullableObservableSupplier<Tab> currentTabSupplier) {
+        OrbitShieldsButton button = ServiceLoaderUtil.maybeCreate(OrbitShieldsButton.class);
+        if (button == null) return null;
+        button.initialize(
+                activity, windowAndroid, taskSupplier, tabModelSelectorSupplier, currentTabSupplier);
+        return button;
+    }
+
+    /** Called once by {@link #maybeCreate}. */
+    @Initializer
+    void initialize(
+            Activity activity,
+            WindowAndroid windowAndroid,
+            OneshotSupplier<ChromeAndroidTask> taskSupplier,
+            Supplier<@Nullable TabModelSelector> tabModelSelectorSupplier,
+            NullableObservableSupplier<Tab> currentTabSupplier);
+}

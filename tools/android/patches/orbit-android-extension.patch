+namespace {
+
+// Orbit's built-in extension is packed into the APK as assets. The loader reads plain files, so
+// they are copied to the app's data folder, and copied again when an update brings new ones.
+constexpr const char* kOrbitExtensionAssets[] = {
+    "kceipbaiojomdibnboffoieecidpfdck.json",
+    "orbit.crx",
+};
+
+void CopyOrbitExtensionAssets(const base::FilePath& dir) {
+  if (!base::CreateDirectory(dir)) {
+    LOG(ERROR) << "Cannot create " << dir;
+    return;
+  }
+  for (const char* name : kOrbitExtensionAssets) {
+    base::MemoryMappedFile::Region region;
+    int fd = base::android::OpenApkAsset(
+        std::string("assets/orbit_extensions/") + name, &region);
+    if (fd < 0) {
+      LOG(ERROR) << "Orbit extension asset missing: " << name;
+      return;
+    }
+    base::File asset(fd);
+    std::string contents(region.size, 0);
+    if (!asset.ReadAndCheck(region.offset,
+                            base::as_writable_byte_span(contents))) {
+      LOG(ERROR) << "Cannot read Orbit extension asset " << name;
+      return;
+    }
+    base::FilePath target = dir.AppendASCII(name);
+    std::string existing;
+    if (base::ReadFileToString(target, &existing) && existing == contents) {
+      continue;
+    }
+    if (!base::WriteFile(target, contents)) {
+      LOG(ERROR) << "Cannot write " << target;
+      return;
+    }
+  }
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_ANDROID)
